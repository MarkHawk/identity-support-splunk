# Copy to .env (gitignored) and fill in, or run: python3 scripts/init_env.py
# Nothing here is ever printed by the scripts.

# The sender: where to ship events, and the HEC token to use.
HEC_URL=
HEC_TOKEN=
HEC_INDEX=identity_support

# The reviewer stack (compose.yaml): admin password and the HEC token it creates.
SPLUNK_PASSWORD=
DEMO_HEC_TOKEN=
